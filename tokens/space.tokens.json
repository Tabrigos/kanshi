{
  "space": {
    "$type": "dimension",
    "$description": "A 4 px step.",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 24, "unit": "px" } },
    "6": { "$value": { "value": 40, "unit": "px" } }
  },
  "frame": {
    "$type": "dimension",
    "line": { "$value": { "value": 1, "unit": "px" }, "$description": "Panel border" },
    "corner": { "$value": { "value": 10, "unit": "px" }, "$description": "Length of the bright corner marks of a panel" },
    "grid": { "$value": { "value": 48, "unit": "px" }, "$description": "Cell of the background grid" }
  },
  "motion": {
    "$type": "duration",
    "blink": {
      "$value": { "value": 1000, "unit": "ms" },
      "$description": "Period of an alarm blink: one flash per second, under the WCAG 2.3.1 limit of three"
    }
  }
}
