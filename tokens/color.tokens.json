{
  "palette": {
    "$type": "color",
    "$description": "Raw values, not meant for components: the CSS uses the roles in `color`. Provisional: chosen by eye, to be replaced by values sampled from frames of the original series.",
    "void": { "$value": { "colorSpace": "srgb", "components": [0.0157, 0.0196, 0.0235], "hex": "#040506" }, "$description": "The monitor glass when nothing is drawn" },
    "panel": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0471, 0.051], "hex": "#0a0c0d" } },
    "line": { "$value": { "colorSpace": "srgb", "components": [0.5412, 0.3333, 0.0745], "hex": "#8a5513" } },
    "amber": { "$value": { "colorSpace": "srgb", "components": [1, 0.6039, 0.1216], "hex": "#ff9a1f" } },
    "amber-dim": { "$value": { "colorSpace": "srgb", "components": [0.7216, 0.4392, 0.102], "hex": "#b8701a" } },
    "red": { "$value": { "colorSpace": "srgb", "components": [1, 0.2275, 0.1804], "hex": "#ff3a2e" } },
    "green": { "$value": { "colorSpace": "srgb", "components": [0.2627, 0.9137, 0.4824], "hex": "#43e97b" } },
    "paper": { "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9294, 0.8941], "hex": "#f1ede4" } }
  },
  "color": {
    "$type": "color",
    "$description": "Roles: the only color tokens the CSS uses. A `kanshi.contrast` extension is a promise the tests check: the token's contrast against each `on` token is at least `min` (WCAG 2.2, 1.4.3 for text, 1.4.11 for frames).",
    "background": { "$value": "{palette.void}", "$description": "Page background" },
    "surface": { "$value": "{palette.panel}", "$description": "Panel background" },
    "border": {
      "$value": "{palette.line}",
      "$description": "Panel frames and dividers",
      "$extensions": { "kanshi.contrast": { "on": ["color.background", "color.surface"], "min": 3 } }
    },
    "text": {
      "$value": "{palette.paper}",
      "$description": "Values and primary text",
      "$extensions": { "kanshi.contrast": { "on": ["color.background", "color.surface"], "min": 4.5 } }
    },
    "text-dim": {
      "$value": "{palette.amber-dim}",
      "$description": "Labels, units, secondary text",
      "$extensions": { "kanshi.contrast": { "on": ["color.background", "color.surface"], "min": 4.5 } }
    },
    "accent": {
      "$value": "{palette.amber}",
      "$description": "The signal color: title tabs, active controls, data lines",
      "$extensions": { "kanshi.contrast": { "on": ["color.background", "color.surface"], "min": 4.5 } }
    },
    "on-accent": {
      "$value": "{palette.void}",
      "$description": "Text set on an accent fill",
      "$extensions": { "kanshi.contrast": { "on": ["color.accent"], "min": 4.5 } }
    },
    "ok": {
      "$value": "{palette.green}",
      "$extensions": { "kanshi.contrast": { "on": ["color.background", "color.surface"], "min": 4.5 } }
    },
    "warning": {
      "$value": "{palette.amber}",
      "$extensions": { "kanshi.contrast": { "on": ["color.background", "color.surface"], "min": 4.5 } }
    },
    "critical": {
      "$value": "{palette.red}",
      "$extensions": { "kanshi.contrast": { "on": ["color.background", "color.surface"], "min": 4.5 } }
    },
    "on-critical": {
      "$value": "{palette.void}",
      "$description": "Text set on a critical fill, such as an alarm hexagon",
      "$extensions": { "kanshi.contrast": { "on": ["color.critical"], "min": 4.5 } }
    }
  }
}
